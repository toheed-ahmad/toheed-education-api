      "sections": [
        {
          "category": "Articles",
          "rules": [
            "Use 'A' before consonants: A cat, A book, A pen",
            "Use 'An' before vowels: An apple, An elephant, An umbrella",
            "Use 'The' for specific things: The sun, The moon"
          ]
        },
        {
          "category": "Pronouns",
          "rules": [
            "I, You, He (for boys), She (for girls)",
            "It (for objects/animals)",
            "We, They (for groups)"
          ]
